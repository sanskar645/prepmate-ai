SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

OPENAI_API_KEY=your-openai-api-key
GOOGLE_API_KEY=your-google-gemini-api-key

# Speech-to-text. Groq's Whisper is on a free tier (no credits needed) and is
# preferred automatically; OpenAI's whisper-1 is kept as a fallback but needs
# paid credit on the account.
#   console.groq.com/keys  ->  GROQ_API_KEY=gsk_...
GROQ_API_KEY=your-groq-api-key
# auto (default) = groq, then openai. Pin with: groq | openai
STT_PROVIDER=auto
GROQ_STT_MODEL=whisper-large-v3
#   whisper-large-v3-turbo = lower latency, slightly less accurate
OPENAI_STT_MODEL=whisper-1
# Optional override. Verified working on a free-tier key:
#   gemini-flash-lite-latest (default), gemini-3.1-flash-lite
GEMINI_MODEL=gemini-flash-lite-latest

DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
# Only these addresses may sign up. Must match the register page's hint.
INSTITUTION_EMAIL_DOMAIN=mitsgwl.ac.in

# Comma-separated frontend origins allowed to call the API.
# Local dev: http://localhost:3000. Prod: your Vercel URL (+ preview URLs).
CORS_ORIGINS=http://localhost:3000
